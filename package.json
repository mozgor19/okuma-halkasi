{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "mobile:dev": "corepack pnpm --dir mobile start",
    "mobile:android": "corepack pnpm --dir mobile android",
    "mobile:ios": "corepack pnpm --dir mobile ios",
    "mobile:typecheck": "corepack pnpm --dir mobile typecheck",
    "groups:setup": "node scripts/groups-development.mjs",
    "self-service:dev": "node scripts/self-service-development.mjs",
    "self-service:mail": "OKUMA_TEST_RUN_ID=${OKUMA_TEST_RUN_ID:-self-service-web} node scripts/development-mail.mjs",
    "self-service:test": "node scripts/test-self-service.mjs",
    "staging:status": "node scripts/staging-cloudflare.mjs status",
    "staging:init": "node scripts/staging-cloudflare.mjs init",
    "staging:prepare": "node scripts/staging-cloudflare.mjs prepare",
    "staging:deploy": "node scripts/staging-cloudflare.mjs deploy",
    "staging:credentials": "node scripts/staging-cloudflare.mjs credentials",
    "staging:test": "node scripts/test-staging.mjs",
    "staging:mail:authorize": "node scripts/gmail-oauth.mjs",
    "staging:mail:install": "node scripts/staging-cloudflare.mjs mail",
    "staging:mail:test": "node --experimental-strip-types scripts/staging-mail.mjs",
    "groups:dev": "OKUMA_GROUPS_DEVELOPMENT=1 node scripts/run-framework.mjs dev --port 5174",
    "groups:dev:legacy": "OKUMA_GROUPS_DEVELOPMENT=legacy vite --port 5175",
    "groups:test": "node scripts/test-reading-groups.mjs",
    "groups:test:unit": "node scripts/test-reading-groups-unit.mjs",
    "groups:test:ui": "node scripts/test-reading-groups-ui.mjs",
    "groups:test:branding": "node scripts/test-group-branding.mjs",
    "test:release": "node scripts/release-tests.mjs",
    "test:release:android": "node scripts/release-tests.mjs --android",
    "test:release:unit": "node --experimental-strip-types --test scripts/tests/*.test.mjs",
    "release:check": "node scripts/check-android-release.mjs",
    "groups:test:legacy": "node scripts/test-legacy-web.mjs",
    "groups:test:memberships": "node scripts/test-reading-group-memberships.mjs",
    "mobile:test:android": "node scripts/test-android-shell.mjs",
    "mobile:test:android:media": "node scripts/test-android-media.mjs",
    "mobile:test:android:notifications": "node scripts/test-android-notifications.mjs",
    "db:generate": "drizzle-kit generate",
    "check:ui": "node scripts/check-ui-contract.mjs",
    "generate:icons": "node scripts/generate-app-icons.mjs",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "web:test:pwa": "node scripts/test-web-pwa.mjs",
    "web:test:experience": "node scripts/test-web-experience.mjs",
    "web:test:updates": "node scripts/test-pwa-updates.mjs",
    "web:images": "node scripts/optimize-web-images.mjs",
    "web:preview:local": "node scripts/preview-local-production.mjs",
    "web:measure": "node scripts/measure-web-performance.mjs",
    "web:release:check": "node scripts/check-web-release.mjs",
    "web:preflight": "node scripts/web-production-preflight.mjs",
    "web:auth:preflight": "node scripts/firebase-production-preflight.mjs",
    "web:backup:drill": "node scripts/backup-production-d1.mjs",
    "web:migration:rehearse": "node scripts/rehearse-production-migration.mjs",
    "web:test:production": "node scripts/test-web-production.mjs",
    "auth:prototype:unit": "corepack pnpm --dir prototypes/firebase-auth test:unit",
    "auth:prototype:test": "corepack pnpm --dir prototypes/firebase-auth test",
    "auth:prototype:audit": "corepack pnpm --dir prototypes/firebase-auth run audit",
    "auth:test:preflight": "node prototypes/firebase-auth/preflight-test-project.mjs",
    "auth:test:remote": "node prototypes/firebase-auth/remote-test.mjs",
    "auth:local:dev": "node scripts/firebase-local-integration.mjs",
    "auth:local:test": "node scripts/firebase-local-integration.mjs --test",
    "info:build": "node scripts/build-public-info.mjs",
    "info:test": "node scripts/test-public-info.mjs",
    "info:deploy": "node scripts/deploy-public-info.mjs",
    "info:test:https": "node scripts/test-public-info-https.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@shadcn/react": "^0.3.0",
    "@vladmandic/human": "3.3.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.3",
    "input-otp": "^1.4.2",
    "jose": "6.2.12",
    "mimetext": "3.0.28",
    "motion": "^13.4.4",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "google-auth-library": "11.2.0",
    "playwright": "1.62.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "next": {
      "sharp": "0.35.5"
    },
    "source-map-js": "1.2.2"
  },
  "packageManager": "pnpm@11.25.0"
}
