{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "target": "ES2020",
    "baseUrl": ".",
    "paths": {
      "@mobile/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "*.js",
    "app.config.ts"
  ]
}
